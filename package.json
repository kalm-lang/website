{
  "name": "kalm-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/generate.mjs && vite",
    "check": "tsc --noEmit",
    "build": "node scripts/generate.mjs && vite build && node scripts/check-links.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "test:content": "node --test --experimental-test-isolation=none tests/content.test.mjs",
    "verify:code": "node scripts/verify-examples.mjs && node scripts/verify-learn.mjs"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "markdown-it": "15.0.2",
    "shiki": "4.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
