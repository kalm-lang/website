{
  "name": "kalm-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/generate.mjs && vite",
    "host": "node scripts/generate.mjs && vite --host",
    "check": "tsc --noEmit",
    "build": "node scripts/generate.mjs && vite build && node scripts/check-links.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "test:content": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "verify:code": "node scripts/stage-compiler.mjs && node scripts/verify-examples.mjs && node scripts/verify-learn.mjs && node scripts/verify-comparisons.mjs && node scripts/verify-variants.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.4",
    "@kalm-lang/documentation": "1.1.0",
    "@kalm-lang/specification": "1.1.0-full",
    "cross-spawn": "7.0.6",
    "gsap": "3.13.0",
    "lit": "3.3.3",
    "lucide": "1.52.0",
    "markdown-it-container": "4.0.0"
  },
  "devDependencies": {
    "@kalm-lang/syntax-highlighting": "1.1.0",
    "@playwright/test": "1.63.0",
    "@shikijs/langs": "4.5.0",
    "@types/node": "26.6.4",
    "markdown-it": "15.0.2",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "kalmVersion": "0.1.0-SNAPSHOT"
}
